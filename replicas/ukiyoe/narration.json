  "lines": [
    {
      "id": "L1",
      "text": "From home, the mountain was no bigger than a grain of rice.",
      "voice": "am_adam",
      "speed": 0.88,
      "start": 6,
      "duration": 3.495,
      "language": "en-us"
    },
    {
      "id": "L2",
      "text": "The rain taught me to walk slower.",
      "voice": "am_adam",
      "speed": 0.88,
      "start": 12.3,
      "duration": 1.835,
      "language": "en-us"
    },
    {
      "id": "L3",
      "text": "Some evenings, it waited for me in a window.",
      "voice": "am_adam",
      "speed": 0.88,
      "start": 18,
      "duration": 2.568,
      "language": "en-us"
    },
    {
      "id": "L4",
      "text": "Then the sea stood up between us.",
      "voice": "am_adam",
      "speed": 0.86,
      "start": 23.5,
      "duration": 1.907,
      "language": "en-us"
    },
    {
      "id": "L5",
      "text": "The mountain never moved. Only I did.",
      "voice": "am_adam",
      "speed": 0.84,
      "start": 34.4,
      "duration": 2.663,
      "language": "en-us"
    }
  ]
}