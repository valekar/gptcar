{
  "language": "en-us",
  "voice": "am_michael",
  "lines": [
    {
      "id": "v01",
      "text": "Meet Clawd.",
      "voice": "am_michael",
      "speed": 1.0,
      "asr": "Meet Claude.",
      "start": 2.3,
      "duration": 1.412,
      "language": "en-us"
    },
    {
      "id": "v02",
      "text": "It used to live in your terminal.",
      "voice": "am_michael",
      "speed": 1.0,
      "start": 3.5,
      "duration": 2.277,
      "language": "en-us"
    },
    {
      "id": "v03",
      "text": "Now it lives right inside the Claude app.",
      "voice": "am_michael",
      "speed": 1.0,
      "start": 6.2,
      "duration": 2.827,
      "language": "en-us"
    },
    {
      "id": "v04",
      "text": "Just say what you want, in plain words.",
      "voice": "am_michael",
      "speed": 1.0,
      "start": 10.9,
      "duration": 2.688,
      "language": "en-us"
    },
    {
      "id": "v05",
      "text": "Point at a file with the at sign,",
      "voice": "am_michael",
      "speed": 1.0,
      "start": 13.5,
      "duration": 2.3040000000000003,
      "language": "en-us"
    },
    {
      "id": "v06",
      "text": "and Claude reads your project before it touches a thing.",
      "voice": "am_michael",
      "speed": 1.0,
      "start": 16.1,
      "duration": 3.5010000000000003,
      "language": "en-us"
    },
    {
      "id": "v07",
      "text": "Not sure yet? Switch to Plan mode.",
      "voice": "am_michael",
      "speed": 1.0,
      "start": 20.3,
      "duration": 2.7110000000000003,
      "language": "en-us"
    },
    {
      "id": "v08",
      "text": "You get a clear plan, and nothing changes until you say go.",
      "voice": "am_michael",
      "speed": 1.0,
      "start": 22.9,
      "duration": 4.21,
      "language": "en-us"
    },
    {
      "id": "v09",
      "text": "Every edit shows up as a diff.",
      "voice": "am_michael",
      "speed": 1.0,
      "start": 28.1,
      "duration": 2.351,
      "language": "en-us"
    },
    {
      "id": "v10",
      "text": "Click any line, leave a note,",
      "voice": "am_michael",
      "speed": 1.0,
      "start": 30.5,
      "duration": 2.125,
      "language": "en-us"
    },
    {
      "id": "v11",
      "text": "and Claude revises it.",
      "voice": "am_michael",
      "speed": 1.0,
      "start": 32.8,
      "duration": 1.882,
      "language": "en-us"
    },
    {
      "id": "v12",
      "text": "Then it checks its own work.",
      "voice": "am_michael",
      "speed": 1.0,
      "start": 36.5,
      "duration": 1.9609999999999999,
      "language": "en-us"
    },
    {
      "id": "v13",
      "text": "It runs your app in the preview, and clicks through it, just like you would.",
      "voice": "am_michael",
      "speed": 1.0,
      "start": 38.2,
      "duration": 4.672000000000001,
      "language": "en-us"
    },
    {
      "id": "v14",
      "text": "Got more to do? Start another session.",
      "voice": "am_michael",
      "speed": 1.0,
      "start": 43,
      "duration": 2.818,
      "language": "en-us"
    },
    {
      "id": "v15",
      "text": "They work side by side.",
      "voice": "am_michael",
      "speed": 1.0,
      "start": 45.8,
      "duration": 2.007,
      "language": "en-us"
    },
    {
      "id": "v16",
      "text": "Claude Code.",
      "voice": "am_michael",
      "speed": 1.0,
      "start": 50.8,
      "duration": 1.3780000000000001,
      "language": "en-us"
    },
    {
      "id": "v17",
      "text": "Say it. Plan it. Review it. Ship it.",
      "voice": "am_michael",
      "speed": 1.0,
      "start": 52.42,
      "duration": 2.388,
      "language": "en-us"
    }
  ]
}