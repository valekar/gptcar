    {
      "id": "L1",
      "text": "The river keeps no name. It waits for no one.",
      "voice": "bm_george",
      "speed": 0.86,
      "lang": "en-gb",
      "start": 10.6,
      "duration": 3.456,
      "language": "en-gb"
    },
    {
      "id": "L2",
      "text": "He crossed it the only way he knew... lightly.",
      "voice": "bm_george",
      "speed": 0.86,
      "lang": "en-gb",
      "start": 15.6,
      "duration": 3.183,
      "language": "en-gb"
    },
    {
      "id": "L3",
      "text": "Halfway over, the river rose to meet him.",
      "voice": "bm_george",
      "speed": 0.86,
      "lang": "en-gb",
      "start": 22.5,
      "duration": 3.237,
      "language": "en-gb"
    },
    {
      "id": "L4",
      "text": "Draw a sword to cut the water...",
