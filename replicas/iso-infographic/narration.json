{
  "voice": "bf_alice",
  "language": "en-gb",
  "lines": [
    {
      "id": "L1",
      "start": 2.55,
      "end": 5.2,
      "text": "How far did your coffee travel?",
      "voice": "bf_alice",
      "speed": 1.0
    },
    {
      "id": "L2",
      "start": 8.4,
      "end": 12.6,
      "text": "It began as a cherry on a hillside, with two seeds inside.",
      "voice": "bf_alice",
      "speed": 0.97
    },
    {
      "id": "L3",
      "start": 12.9,
      "end": 17.05,
      "text": "Dried in the sun, then packed with four hundred thousand others.",
      "voice": "bf_alice",
      "speed": 1.0
    },
    {
      "id": "L4",
      "start": 23.4,
      "end": 25.7,
      "text": "Eighteen days at sea.",
      "voice": "bf_alice",
      "speed": 0.92
    },
    {
      "id": "L5",
      "start": 30.9,
      "end": 33.55,
      "text": "Somewhere in here is yours.",
      "voice": "bf_alice",
      "speed": 0.9
    },
    {
      "id": "L6",
      "start": 49.9,
      "end": 54.4,
      "text": "Eleven thousand kilometres, from one pair of hands to yours.",
      "voice": "bf_alice",
      "speed": 0.92
    }
  ]
}
