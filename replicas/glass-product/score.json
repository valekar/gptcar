  "sections": [
    {
      "start": 0,
      "end": 4,
      "intent": "Near-black sub drone, moving inharmonic glass shimmers, contour revealed by two light sweeps."
    },
    {
      "start": 4,
      "end": 8,
      "intent": "Restrained F-minor FM glass arpeggio gradually opens; friction and lid-click punctual, no acoustic orchestration."
    },
    {
      "start": 8,
      "end": 12,
      "intent": "Soft short kicks every beat below macro glass sweeps; intimate dry voice."
    },
    {
      "start": 12,
      "end": 15.5,
      "intent": "Glass-metal stack unzips; rising saw/noise tension, air puffs; music grows then hard stops."
    },
    {
      "start": 15.5,
      "end": 16,
      "intent": "Total music silence, tails cut; only reverse suction into snap."
    },
    {
      "start": 16,
      "end": 24,
      "intent": "F1 syncopated808-like sub release atbar offsets0,.75,1,1.5; clap2/4; new four-note glass motif. Light follows exact shared list."
    },
    {
      "start": 24,
      "end": 28,
      "intent": "Minor9 pad and bell declamation; restrained voice; metallic settle punctuation."
    },
    {
      "start": 28,
      "end": 32,
      "intent": "High glass ding, soft sustained F minor resolution and decaying cool glow; final0.6fade."
    }
  ],
